# Copia este fichero como .env y rellena los valores.
# .env está en .gitignore: no debe subirse nunca al repositorio.

# Base de datos de la Panadería
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=data

# Base de datos donde se escriben las predicciones
DB_SANDBOX=sandbox

# Identificador para la tabla de resultados
GROUP_NAME=

# Servidor de MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_SERVING_URI=http://127.0.0.1:5001/invocations
